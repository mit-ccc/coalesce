# Copy this file to server/.env and fill in the values.
# server/.env is gitignored — never commit real credentials.

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Flask session secret — any long random string works
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-secret

# OpenAI API key (used by DSPy for GPT-3.5 / GPT-4o calls)
OPENAI_API_KEY=sk-...

# Redis broker URL
# When running with Docker Compose, keep this value — it matches the redis service name.
# When running without Docker, change to redis://localhost:6379/0.
REDIS_BROKER_URL=redis://redis:6379/0

# Set to "false" to disable all database writes (useful for local development/testing)
WRITE_TO_DB=true

# Google Sheets export URLs used by get_prompt_info.py (optional — only needed for internal analytics)
NEW_PROMPTS_SHEET_URL=
SPREADSHEET_URL=
