# Copy this file to .env.deploy and fill in your values.
# .env.deploy is gitignored — never commit real values.
# Used by the Makefile for AWS deployment targets.

# EC2 instance public DNS or IP address
EC2_INSTANCE=ec2-<ip-address>.compute.amazonaws.com

# CloudFront distribution ID (found in the AWS CloudFront console)
CLOUDFRONT_DISTRIBUTION_ID=<distribution-id>

# Domain / S3 bucket name for the frontend (must match your S3 bucket name)
DOMAIN=your-app.example.com

# Docker container name on the EC2 instance
CONTAINER_NAME=ubuntu-backend-prod-1
